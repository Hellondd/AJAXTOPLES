<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — SecureFilesMvc</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="top">
        <strong>SecureFilesMvc</strong>
        <nav>
            <a asp-controller="Home" asp-action="Index">Главная</a>
            <a asp-controller="Threats" asp-action="Index">Модель угроз</a>
            <a asp-controller="Files" asp-action="Index">Файлы</a>
        </nav>
    </header>
    <main>
        @RenderBody()
    </main>
    @* Только внешние скрипты — CSP запрещает inline. Скрипты страниц — в секции Scripts. *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
